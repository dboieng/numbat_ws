<?xml version="1.0"?>
<package format="3">
  <name>servo_move_keyboard</name>
  <version>0.0.0</version>
  <description>Package to move servos via keyboard inputs</description>

  <maintainer email="mike@todo.todo">mike</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>i2c_pwm_board_msgs</exec_depend>

  <!-- Only needed if this package's launch file starts the PWM board node -->
  <exec_depend>i2c_pwm_board</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>